---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Live games, newest first. Descriptions are taken from each launch post.
const gameList = [
	{
		name: 'Tidewatch',
		post: 'tidewatch',
		play: 'https://mikenev.github.io/tidewatch/',
		blurb: 'A pirate tower defense game: defend a walled port town from pirate ships across three islands, from a sunny tropical cay to a foggy, stormy isle at night.',
	},
	{
		name: 'Broomstick Bash: Free Flight',
		post: 'broomstick-bash-free-flight',
		play: 'https://mikenev.github.io/broomstick-bash-free-flight/',
		blurb: 'A free-flying remix of Broomstick Bash: steer the witch anywhere on screen, dodge a faster Halloween street, and face a reworked three-phase werewolf.',
	},
	{
		name: 'Broomstick Bash',
		post: 'broomstick-bash',
		play: 'https://mikenev.github.io/broomstick-bash/',
		blurb: 'A 2.5D Halloween flyer: a witch on a broom dodges trick-or-treaters and spooks down a haunted street, then battles a werewolf.',
	},
	{
		name: 'Explorer Dash',
		post: 'explorer-dash',
		play: 'https://mikenev.github.io/explorer-dash/',
		blurb: 'An original pulp jungle-adventure endless runner in 3D: grab the idol, then outrun a giant rolling boulder.',
	},
	{
		name: 'Puffin Platformer',
		post: 'puffin-platformer',
		play: 'https://mikenev.github.io/puffin-platformer/',
		blurb: 'A 16-bit style platformer starring a puffin, made in Godot, where colored fish give the puffin new powers.',
	},
];

const games = await Promise.all(
	gameList.map(async (g) => ({ ...g, entry: await getEntry('blog', g.post) })),
);

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.intro {
				max-width: 720px;
				margin: 0 auto 2.5em;
				text-align: center;
			}
			.intro h1 {
				margin-bottom: 0.25em;
			}
			.intro p {
				margin: 0.5em 0;
			}
			h2 {
				margin: 0 0 0.75em;
			}
			.games,
			.posts {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 0 0 3em;
				padding: 0;
			}
			.posts {
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.5rem;
			}
			.card img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 12px;
				margin-bottom: 0.5rem;
			}
			.card a:hover img {
				box-shadow: var(--box-shadow);
			}
			.card h3 {
				margin: 0.25em 0;
				font-size: 1.563em;
				line-height: 1.2;
			}
			.card h3 a,
			.posts a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.card h3 a:hover,
			.posts a:hover .title {
				color: rgb(var(--accent));
			}
			.blurb {
				margin: 0 0 0.5em;
				font-size: 1rem;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
			}
			.links {
				margin: 0;
				font-size: 1rem;
			}
			.links .play {
				font-weight: 700;
			}
			.posts .title {
				margin: 0;
				font-size: 1.1em;
				line-height: 1.25;
			}
			.date {
				margin: 0.25em 0 0;
				font-size: 0.95rem;
				color: rgb(var(--gray));
			}
			.all-posts {
				margin-top: -2em;
				text-align: right;
			}
			@media (max-width: 720px) {
				.games,
				.posts {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
				.intro {
					margin-bottom: 1.5em;
				}
				.all-posts {
					margin-top: -1em;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Hi, I'm Mike.</h1>
				<p>
					I build small web games with a team of AI bots, and I write up each launch on the <a href="/blog/">blog</a>. Every game below runs right in your browser.
				</p>
			</section>

			<section>
				<h2>Games</h2>
				<ul class="games">
					{
						games.map((g) => (
							<li class="card">
								<a href={g.play}>
									{g.entry?.data.heroImage && (
										<Image
											width={720}
											height={405}
											src={g.entry.data.heroImage}
											alt={g.entry.data.heroImageAlt ?? `Screenshot of ${g.name}`}
										/>
									)}
								</a>
								<h3><a href={g.play}>{g.name}</a></h3>
								<p class="blurb">{g.blurb}</p>
								<p class="links">
									<a class="play" href={g.play}>Play</a>
									{g.entry && (
										<>
											{' · '}
											<a href={`/blog/${g.entry.id}/`}>Read the post</a>
										</>
									)}
								</p>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2>Latest posts</h2>
				<ul class="posts">
					{
						latestPosts.map((post) => (
							<li class="card">
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={405} src={post.data.heroImage} alt={post.data.heroImageAlt ?? ''} />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
				<p class="all-posts"><a href="/blog/">All posts →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
